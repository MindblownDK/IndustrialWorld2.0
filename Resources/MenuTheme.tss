/* Industrial World — Main Menu runtime theme.
 * Inherits the full Unity default control set (button, slider, scrollview,
 * text field…). Required so PanelSettings doesn't log
 * "No Theme Style Sheet set to PanelSettings, UI will not render properly".
 *
 * All visual styling is applied programmatically via VoxelEngine.UI.UITheme;
 * this sheet exists only to satisfy UI Toolkit's runtime style pipeline.
 */
@import url("unity-theme://default");
